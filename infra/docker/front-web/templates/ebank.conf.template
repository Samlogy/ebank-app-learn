# Rendered at startup: only ${EBANK_*} variables are substituted (NGINX_ENVSUBST_FILTER), so nginx
# variables such as $uri are left alone.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # add_header is not inherited by a location that has its own, so each location includes them.

    # The runtime config, rendered from config.json.template with this container's EBANK_* values.
    # It wins over the public/config.json that the build copies, which only serves `ng serve`.
    location = /config.json {
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        alias /tmp/nginx/config.json;
    }

    location = /index.html {
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    # Not content-hashed by the build, so they must not be cached for a year.
    location ~ ^/(theme-init|silent-check-sso)\.js$ {
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # Angular adds a content hash to these file names.
    location ~* \.(js|css|ico|png|svg|woff2)$ {
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routes fall back to the Angular app.
    location / {
        include /tmp/nginx/security-headers.inc;
        try_files $uri /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
