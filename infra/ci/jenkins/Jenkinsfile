// EBANK pipeline. In the Jenkins job, set "Script Path" to infra/ci/jenkins/Jenkinsfile.
//
// Needs, configured in Jenkins:
//   - a SonarQube server named "sonarqube" (Manage Jenkins > System) with its webhook back to Jenkins
//   - credentials: "dockerhub" (username + access token), and per environment (dev, qua, prod)
//     "kubeconfig-<env>" (secret file) and "vault-approle-<env>" (username = AppRole role ID,
//     password = secret ID of ebank-<env>-ci, see infra/vault/README.md)
//   - a "ebank-release-managers" group or user, who approves the prod deploy
//   - once infra/ci/cosign/cosign.pub is committed: "cosign-key" (secret file, the private key)
//     and "cosign-password" (secret text). Images are then signed after the push and verified
//     before each deploy (README, "Image signing").
//   - agents that can reach the host's Docker socket (Testcontainers, image builds, scanners)
//
// Every branch: secrets scan, build and tests, SonarQube quality gate, SAST, IaC and dependency
// scans, API contract, image build and scan. master also pushes the images, deploys to dev (with
// smoke test and automatic rollback), runs DAST, deploys the same images to qua, and to prod after
// an approval.

pipeline {
    agent {
        dockerfile {
            dir 'infra/ci/jenkins'
            filename 'agent.Dockerfile'
            // Same path inside and outside the agent, so dockerized tools can mount the workspace.
            args '-v /var/run/docker.sock:/var/run/docker.sock --group-add docker --add-host=host.docker.internal:host-gateway -v $HOME/.m2:/root/.m2 -v $HOME/.npm:/root/.npm'
        }
    }

    options {
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        REGISTRY = 'docker.io/ebank'
        IMAGE_TAG = "${env.GIT_COMMIT.take(12)}"
        REPORTS = "${env.WORKSPACE}/reports"
        // Testcontainers talks to the host daemon through the mounted socket.
        TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
        DEV_URL = 'http://app.ebank.localhost'
    }

    stages {
        stage('Secrets scan') {
            steps {
                sh 'mkdir -p "$REPORTS" && infra/ci/security/scan.sh secrets'
            }
        }

        stage('Build and test') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            // Unit, architecture and integration tests (Testcontainers), coverage and SBOM.
                            sh './mvnw -B -ntp -Pci verify'
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: false,
                                  testResults: 'backend/**/target/surefire-reports/*.xml, backend/**/target/failsafe-reports/*.xml'
                            archiveArtifacts artifacts: 'backend/target/classes/META-INF/sbom/application.cdx.json', allowEmptyArchive: true
                        }
                    }
                }
                stage('Front end') {
                    steps {
                        dir('front-web') {
                            sh 'npm ci --no-audit --no-fund'
                            sh 'npx ng test --watch=false --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary'
                            sh 'npm run build'
                            sh 'npx --yes @cyclonedx/cyclonedx-npm@4.1.2 --omit dev --output-file bom.json'
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'front-web/bom.json', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    dir('backend') {
                        sh './mvnw -B -ntp -Pci sonar:sonar -Dsonar.branch.name=$BRANCH_NAME'
                    }
                    sh '''
                        docker run --rm -v "$WORKSPACE:$WORKSPACE" -w "$WORKSPACE" \
                          -e SONAR_HOST_URL -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                          sonarsource/sonar-scanner-cli:11.4 \
                          -Dproject.settings=infra/ci/sonarqube/front-web.properties
                    '''
                }
            }
        }

        stage('Quality gate') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Security scans') {
            parallel {
                stage('SAST') {
                    steps { sh 'infra/ci/security/scan.sh sast' }
                }
                stage('Dependencies') {
                    steps { sh 'infra/ci/security/scan.sh deps' }
                }
                stage('Infrastructure as code') {
                    steps { sh 'infra/ci/security/scan.sh iac' }
                }
                stage('Alert rules') {
                    steps { sh 'infra/ci/security/scan.sh rules' }
                }
                stage('API contract') {
                    // backend/openapi/ebank-api.json must match what the backend serves (written by
                    // OpenApiSpecIT during the build) and stay backward compatible with master's.
                    steps {
                        sh '''
                            git fetch --no-tags origin +refs/heads/master:refs/remotes/origin/master || true
                            infra/ci/security/scan.sh api
                        '''
                    }
                }
            }
        }

        stage('Images') {
            steps {
                sh '''
                    docker build -f infra/docker/backend/Dockerfile -t "$REGISTRY/ebank-backend:$IMAGE_TAG" backend
                    docker build -f infra/docker/front-web/Dockerfile --build-context docker-config=infra/docker/front-web \
                      -t "$REGISTRY/ebank-front-web:$IMAGE_TAG" front-web
                '''
            }
        }

        stage('Image scan') {
            steps {
                sh 'infra/ci/security/scan.sh image "$REGISTRY/ebank-backend:$IMAGE_TAG"'
                sh 'infra/ci/security/scan.sh image "$REGISTRY/ebank-front-web:$IMAGE_TAG"'
            }
        }

        stage('Push') {
            when { branch 'master' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_TOKEN')]) {
                    sh '''
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin docker.io
                        for image in ebank-backend ebank-front-web; do
                          docker push "$REGISTRY/$image:$IMAGE_TAG"
                        done
                    '''
                }
            }
            post {
                always { sh 'docker logout docker.io || true' }
            }
        }

        // Turned on by committing the public key: until then nothing is signed nor verified.
        stage('Sign') {
            when {
                allOf {
                    branch 'master'
                    expression { fileExists('infra/ci/cosign/cosign.pub') }
                }
            }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_TOKEN'),
                    file(credentialsId: 'cosign-key', variable: 'COSIGN_KEY'),
                    string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD'),
                ]) {
                    // cosign pushes the signatures next to the images, so it needs the registry login.
                    sh '''
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin docker.io
                        infra/ci/sign-images.sh
                    '''
                }
            }
            post {
                always { sh 'docker logout docker.io || true' }
            }
        }

        // Build once, promote the same image: dev, then qua, then prod after an approval.
        // infra/ci/deploy.sh <env>: AppRole login to Vault and config from git, helm upgrade --atomic
        // (rolled back by Helm if the pods never get ready), smoke test, rollback if it fails.
        stage('Deploy dev') {
            when { branch 'master' }
            steps {
                deployTo('dev')
            }
        }

        stage('DAST') {
            when { branch 'master' }
            steps {
                sh 'infra/ci/security/scan.sh dast "$DEV_URL"'
            }
        }

        stage('Deploy qua') {
            when { branch 'master' }
            steps {
                deployTo('qua')
            }
        }

        stage('Approve prod') {
            when { branch 'master' }
            steps {
                // Holds this build's agent while waiting: a day at most, then the build is aborted
                // and the image can be promoted from a later build.
                timeout(time: 1, unit: 'DAYS') {
                    input message: "Deploy ${env.IMAGE_TAG} to prod? It passed dev, DAST and qua.",
                          ok: 'Deploy to prod',
                          submitter: 'ebank-release-managers'
                }
            }
        }

        stage('Deploy prod') {
            when { branch 'master' }
            steps {
                deployTo('prod')
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
            recordIssues(enabledForFailure: true, tools: [sarif(pattern: 'reports/*.sarif')])
        }
        cleanup {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}

/**
 * One environment's deploy. Credentials per environment:
 *   kubeconfig-<env>     file: kubeconfig of the environment's cluster
 *   vault-approle-<env>  username/password: role ID / secret ID of AppRole ebank-<env>-ci
 *                        (it can only write ebank/<env>/{backend,front-web}/config)
 */
def deployTo(String target) {
    withCredentials([
        file(credentialsId: "kubeconfig-${target}", variable: 'KUBECONFIG'),
        usernamePassword(credentialsId: "vault-approle-${target}", usernameVariable: 'VAULT_ROLE_ID', passwordVariable: 'VAULT_SECRET_ID'),
    ]) {
        sh "infra/ci/deploy.sh ${target}"
    }
}
