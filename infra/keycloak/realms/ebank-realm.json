{
  "realm": "ebank",
  "enabled": true,
  "displayName": "EBANK",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and notContainsUsername and passwordHistory(3) and hashIterations(210000)",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "$(env:KEYCLOAK_SMTP_HOST)",
    "port": "$(env:KEYCLOAK_SMTP_PORT)",
    "from": "$(env:KEYCLOAK_SMTP_FROM)",
    "fromDisplayName": "EBANK"
  },
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Bank customer: only sees their own data"
      },
      {
        "name": "ADMIN",
        "description": "Bank administrator"
      },
      {
        "name": "ADVISOR",
        "description": "Bank advisor: answers customers in the chat, no direct access to banking data"
      },
      {
        "name": "default-roles-ebank",
        "description": "Roles given to every new user",
        "composite": true,
        "composites": {
          "realm": [
            "CUSTOMER"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ebank"
  },
  "clients": [
    {
      "clientId": "ebank-notifications",
      "name": "EBANK notifications (service account)",
      "description": "Backend only: reads offline users' email and phone, and lists advisors for queue alerts. Dev secret: set another one outside dev.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KEYCLOAK_NOTIFICATIONS_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "ebank-api",
      "name": "EBANK API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "ebank-web",
      "name": "EBANK web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "$(env:EBANK_APP_URL)/*"
      ],
      "webOrigins": [
        "$(env:EBANK_APP_URL)"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$(env:EBANK_APP_URL)/*"
      },
      "protocolMappers": [
        {
          "name": "audience-ebank-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ebank-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-ebank-notifications",
      "enabled": true,
      "serviceAccountClientId": "ebank-notifications",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "view-realm"
        ]
      }
    }
  ],
  "browserFlow": "ebank-browser",
  "authenticatorConfig": [
    {
      "alias": "user-is-admin",
      "config": {
        "condUserRole": "ADMIN",
        "negate": "false"
      }
    },
    {
      "alias": "user-is-not-admin",
      "config": {
        "condUserRole": "ADMIN",
        "negate": "true"
      }
    },
    {
      "alias": "user-is-advisor",
      "config": {
        "condUserRole": "ADVISOR",
        "negate": "false"
      }
    },
    {
      "alias": "user-is-not-advisor",
      "config": {
        "condUserRole": "ADVISOR",
        "negate": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "ebank-browser",
      "description": "Browser login: TOTP is required for ADMIN and optional for everyone else",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "ebank-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-forms",
      "description": "Password, then TOTP when it applies",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "ebank-admin-otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "ebank-advisor-otp",
          "requirement": "CONDITIONAL",
          "priority": 25,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "ebank-customer-otp",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-admin-otp",
      "description": "ADMIN must use TOTP, and must set it up on first login",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "user-is-admin"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-customer-otp",
      "description": "Customers only need TOTP if they set it up",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "user-is-not-admin"
        },
        {
          "flowAlias": "ebank-customer-otp-not-advisor",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-advisor-otp",
      "description": "ADVISOR must use TOTP, and must set it up on first login",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "user-is-advisor"
        },
        {
          "flowAlias": "ebank-advisor-otp-not-admin",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-advisor-otp-not-admin",
      "description": "Advisors who are not admins (admins already got their OTP step)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "user-is-not-admin"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ebank-customer-otp-not-advisor",
      "description": "Customers (neither admin nor advisor): OTP only if they set it up",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "user-is-not-advisor"
        },
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 15,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
