<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.ebank</groupId>
    <artifactId>ebank-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ebank-backend</name>

    <modules>
        <module>ebank-common</module>
        <module>ebank-auth</module>
        <module>ebank-accounts</module>
        <module>ebank-transactions</module>
        <module>ebank-realtime</module>
        <module>ebank-notifications</module>
        <module>ebank-analytics</module>
        <module>ebank-chatbot</module>
        <module>ebank-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.0</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <archunit.version>1.5.1</archunit.version>
        <anthropic-java.version>3.3.0</anthropic-java.version>
        <!-- 2026.0 (made for Boot 4.1) has no GA release yet; 2025.1 works with Boot 4.1, see VaultConfigIT. -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <jacoco.version>0.8.14</jacoco.version>
        <cyclonedx.version>2.9.1</cyclonedx.version>
        <sonar-maven-plugin.version>5.2.0.4988</sonar-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.anthropic</groupId>
                <artifactId>anthropic-java</artifactId>
                <version>${anthropic-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-accounts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-transactions</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-realtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-notifications</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ebank</groupId>
                <artifactId>ebank-chatbot</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- CI only (mvn -Pci): coverage for SonarQube and a CycloneDX SBOM. Local builds stay as they are. -->
    <profiles>
        <profile>
            <id>ci</id>
            <properties>
                <sonar.projectKey>ebank-backend</sonar.projectKey>
                <sonar.projectName>EBANK backend</sonar.projectName>
                <!-- Unit and integration tests together, aggregated in ebank-app. -->
                <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/ebank-app/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.sonarsource.scanner.maven</groupId>
                            <artifactId>sonar-maven-plugin</artifactId>
                            <version>${sonar-maven-plugin.version}</version>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>unit-tests</id>
                                <goals><goal>prepare-agent</goal></goals>
                            </execution>
                            <execution>
                                <id>integration-tests</id>
                                <goals><goal>prepare-agent-integration</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Spring Boot's parent configures the output: target/classes/META-INF/sbom/application.cdx.json.
                         Needs online mode: an offline build (mvn -o) silently skips it. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx.version}</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>makeAggregateBom</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
